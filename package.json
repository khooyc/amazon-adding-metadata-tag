{
  "name": "amazon-adding-metadata-tag",
  "version": "1.6.2",
  "description": "Private local Windows and macOS reviewer for Amazon synthetic-performer XMP tagging of images and videos",
  "main": "electron/main.cjs",
  "author": "khooyc (https://github.com/khooyc)",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/khooyc/amazon-adding-metadata-tag.git"
  },
  "homepage": "https://github.com/khooyc/amazon-adding-metadata-tag",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "dist": "npm run dist:win",
    "dist:win": "npm run test && electron-builder --win nsis --publish never",
    "dist:mac": "npm run test && electron-builder --mac dmg --publish never",
    "pack": "npm run pack:win",
    "pack:win": "electron-builder --dir --win",
    "pack:mac": "electron-builder --dir --mac"
  },
  "dependencies": {
    "@vladmandic/human": "3.3.6",
    "sharp": "0.35.3"
  },
  "optionalDependencies": {
    "exiftool-vendored.exe": "13.59.2",
    "exiftool-vendored.pl": "13.59.2"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "local.khoom.listingmediatagreviewer",
    "productName": "Amazon - Adding Metadata Tag",
    "asar": true,
    "asarUnpack": [
      "node_modules/exiftool-vendored.*/**/*"
    ],
    "files": [
      "electron/**/*",
      "src/**/*",
      "build/icon.png",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ],
      "artifactName": "Amazon-Adding-Metadata-Tag-Windows-Setup.${ext}"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.business",
      "identity": null,
      "hardenedRuntime": false,
      "target": [
        "dmg"
      ],
      "artifactName": "Amazon-Adding-Metadata-Tag-mac-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Amazon - Adding Metadata Tag",
      "uninstallDisplayName": "Amazon - Adding Metadata Tag"
    }
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  }
}
